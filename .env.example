# Flask API
API_AUTH_TOKEN=change-me
HOST=0.0.0.0
PORT=8080

# hsw proof service (Node: solver/browser.js)
HSW_SERVER_URL=http://127.0.0.1:2030
HSW_PORT=2030
HSW_HEADLESS=true
# Optional: use system Chrome/Chromium instead of Puppeteer's bundled browser
# BROWSER_EXECUTABLE=
# Linux example: /usr/bin/google-chrome
# macOS example: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Windows example: C:\Program Files\Google\Chrome\Application\chrome.exe

# Image challenge solving (NoCaptchaAI) — required for image challenges
NOCAPTCHA_UID=
NOCAPTCHA_APIKEY=
NOCAPTCHA_SOLVE_URL=https://free.nocaptchaai.com/solve
